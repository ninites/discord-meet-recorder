# Token du bot : https://discord.com/developers/applications > ton application > Bot > Reset Token
DISCORD_TOKEN=

# Jeton que Claude envoie au serveur MCP. Générer avec : openssl rand -hex 32
MCP_TOKEN=
MCP_PORT=3333

# Modèle Whisper : small (rapide), medium (bon compromis), large-v3 (meilleur, lent sans GPU)
WHISPER_MODEL=medium
WHISPER_LANGUAGE=fr
# Noms propres que Whisper doit reconnaître
WHISPER_INITIAL_PROMPT=Discord, Claude, Docker, GitHub.
# 0 = tous les cœurs du LXC
WHISPER_CPU_THREADS=0
# true pour garder les WAV après transcription (par défaut supprimés)
KEEP_AUDIO=false

# Phrase qui arrête le meet quand quelqu'un la dit (vide : désactivé).
# Plusieurs phrases possibles, séparées par « | » : merci Claude pour les travaux|Claude, coupe l'enregistrement
STOP_PHRASE=merci Claude pour les travaux
# Modèle rapide qui écoute la phrase pendant le meet : base (plus rapide), small (plus fiable)
WHISPER_STOP_MODEL=small

# Salons vocaux (identifiants ou noms exacts, séparés par des virgules) que le bot rejoint
# tout seul dès qu'une personne y entre ; il repart quand le salon reste vide AUTO_STOP_EMPTY_SECONDS.
# Clic droit sur le salon > Copier l'identifiant (mode développeur de Discord).
AUTO_JOIN_CHANNELS=

AUTO_STOP_EMPTY_SECONDS=60
MAX_MEETING_MINUTES=180
